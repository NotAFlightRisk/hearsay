{
  "name": "hearsay",
  "version": "0.1.0",
  "description": "A live globe of the internet's routing, straight from BGP",
  "license": "MIT",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/NotAFlightRisk/hearsay.git"
  },
  "homepage": "https://hearsay.peng.ly",
  "engines": {
    "node": "^22.18.0 || >=24.0.0"
  },
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "start": "node build/index.js",
    "preview": "vite preview",
    "prepare": "svelte-kit sync || echo ''",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json && tsc -p src/relay",
    "test": "vitest run",
    "data": "node scripts/data.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261030.1",
    "@fontsource-variable/atkinson-hyperlegible-mono": "^5.3.0",
    "@fontsource-variable/atkinson-hyperlegible-next": "^5.3.0",
    "@sentry/browser": "^11.10.0",
    "@sentry/vite-plugin": "^11.10.0",
    "@sveltejs/adapter-cloudflare": "^8.0.2",
    "@sveltejs/adapter-node": "^6.0.1",
    "@sveltejs/kit": "^3.1.1",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@types/d3-geo": "^3.1.1",
    "@types/node": "^26.6.6",
    "@types/three": "^0.187.0",
    "d3-geo": "^3.1.1",
    "prettier": "^3.9.10",
    "prettier-plugin-svelte": "^4.1.1",
    "svelte": "^5.57.3",
    "svelte-check": "^4.7.7",
    "three": "^0.187.0",
    "typescript": "^6.0.3",
    "vite": "^8.3.5",
    "vitest": "^5.0.5",
    "wrangler": "^4.156.0"
  },
  "imports": {
    "#lib/*": "./src/lib/*"
  }
}
